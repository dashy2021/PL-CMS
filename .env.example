# Postgres connection string
DATABASE_URL=postgresql://127.0.0.1:5432/bn-cms

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# This CMS's own URL - used for CORS. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# The website that renders the posts - used for the SEO preview URL. No trailing slash
WEBSITE_URL=https://www.businessnext.com

# Lets a cron job run scheduled publishing (/api/payload-jobs/run)
CRON_SECRET=YOUR_CRON_SECRET_HERE

# WordPress migration (pnpm migrate:wp) - all optional
# WP_API_URL=https://www.businessnext.com/blogs/wp-json/wp/v2
# WordPress Application Password, only needed to also pull drafts
# WP_USER=
# WP_APP_PASSWORD=

# Vercel Blob token - set on Vercel; leave empty locally to keep uploads in public/media
# BLOB_READ_WRITE_TOKEN=
